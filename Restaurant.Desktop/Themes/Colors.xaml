<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Colors -->
    <Color x:Key="ColorPrimary">#38e07b</Color>
    <Color x:Key="ColorPrimaryHover">#2bc968</Color>
    <Color x:Key="ColorBackground">#f6f8f7</Color>
    <Color x:Key="ColorSurface">#ffffff</Color>
    <Color x:Key="ColorTextPrimary">#111827</Color>
    <Color x:Key="ColorTextMuted">#6b7280</Color>
    <Color x:Key="ColorBorder">#e5e7eb</Color>
    
    <Color x:Key="ColorDanger">#ef4444</Color>
    <Color x:Key="ColorWarning">#f59e0b</Color>
    <Color x:Key="ColorSuccess">#10b981</Color>
    <Color x:Key="ColorInfo">#3b82f6</Color>

    <!-- Neutral Scale -->
    <Color x:Key="ColorNeutral50">#F9FAFB</Color>
    <Color x:Key="ColorNeutral100">#F3F4F6</Color>
    <Color x:Key="ColorNeutral200">#E5E7EB</Color>
    <Color x:Key="ColorNeutral300">#D1D5DB</Color>
    <Color x:Key="ColorNeutral700">#374151</Color>

    <!-- Primary Tints -->
    <Color x:Key="ColorPrimaryBg">#E8FDF0</Color>
    <Color x:Key="ColorPrimaryLight">#F0FDF4</Color>
    <Color x:Key="ColorPrimaryLighter">#DCFCE7</Color>
    <Color x:Key="ColorPrimaryAlpha8">#1538e07b</Color>
    <Color x:Key="ColorPrimaryAlpha6">#1038e07b</Color>
    <Color x:Key="ColorSuccessAlpha8">#1510b981</Color>
    <Color x:Key="ColorInfoAlpha8">#153b82f6</Color>
    <Color x:Key="ColorWarningAlpha8">#15f59e0b</Color>

    <!-- Warning Semantic -->
    <Color x:Key="ColorWarningBg">#FFFBEB</Color>
    <Color x:Key="ColorWarningBorder">#FEF3C7</Color>
    <Color x:Key="ColorWarningText">#D97706</Color>

    <!-- Info Semantic -->
    <Color x:Key="ColorInfoBg">#EFF6FF</Color>
    <Color x:Key="ColorInfoHover">#DBEAFE</Color>

    <!-- Danger Semantic -->
    <Color x:Key="ColorDangerBg">#FEE2E2</Color>
    <Color x:Key="ColorDangerHover">#FCA5A5</Color>
    <Color x:Key="ColorDangerHoverDark">#dc2626</Color>

    <!-- Success Text -->
    <Color x:Key="ColorSuccessText">#10B981</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}"/>
    <SolidColorBrush x:Key="BrushPrimaryHover" Color="{StaticResource ColorPrimaryHover}"/>
    <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}"/>
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}"/>
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}"/>
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}"/>
    
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}"/>
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}"/>
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}"/>
    <SolidColorBrush x:Key="BrushInfo" Color="{StaticResource ColorInfo}"/>

    <SolidColorBrush x:Key="BrushNeutral50" Color="{StaticResource ColorNeutral50}"/>
    <SolidColorBrush x:Key="BrushNeutral100" Color="{StaticResource ColorNeutral100}"/>
    <SolidColorBrush x:Key="BrushNeutral200" Color="{StaticResource ColorNeutral200}"/>
    <SolidColorBrush x:Key="BrushNeutral300" Color="{StaticResource ColorNeutral300}"/>
    <SolidColorBrush x:Key="BrushNeutral700" Color="{StaticResource ColorNeutral700}"/>

    <SolidColorBrush x:Key="BrushPrimaryBg" Color="{StaticResource ColorPrimaryBg}"/>
    <SolidColorBrush x:Key="BrushPrimaryLight" Color="{StaticResource ColorPrimaryLight}"/>
    <SolidColorBrush x:Key="BrushPrimaryLighter" Color="{StaticResource ColorPrimaryLighter}"/>
    <SolidColorBrush x:Key="BrushPrimaryAlpha8" Color="{StaticResource ColorPrimaryAlpha8}"/>
    <SolidColorBrush x:Key="BrushPrimaryAlpha6" Color="{StaticResource ColorPrimaryAlpha6}"/>
    <SolidColorBrush x:Key="BrushSuccessAlpha8" Color="{StaticResource ColorSuccessAlpha8}"/>
    <SolidColorBrush x:Key="BrushInfoAlpha8" Color="{StaticResource ColorInfoAlpha8}"/>
    <SolidColorBrush x:Key="BrushWarningAlpha8" Color="{StaticResource ColorWarningAlpha8}"/>

    <SolidColorBrush x:Key="BrushWarningBg" Color="{StaticResource ColorWarningBg}"/>
    <SolidColorBrush x:Key="BrushWarningBorder" Color="{StaticResource ColorWarningBorder}"/>
    <SolidColorBrush x:Key="BrushWarningText" Color="{StaticResource ColorWarningText}"/>

    <SolidColorBrush x:Key="BrushInfoBg" Color="{StaticResource ColorInfoBg}"/>
    <SolidColorBrush x:Key="BrushInfoHover" Color="{StaticResource ColorInfoHover}"/>

    <SolidColorBrush x:Key="BrushDangerBg" Color="{StaticResource ColorDangerBg}"/>
    <SolidColorBrush x:Key="BrushDangerHover" Color="{StaticResource ColorDangerHover}"/>
    <SolidColorBrush x:Key="BrushDangerHoverDark" Color="{StaticResource ColorDangerHoverDark}"/>

    <SolidColorBrush x:Key="BrushSuccessText" Color="{StaticResource ColorSuccessText}"/>
</ResourceDictionary>
