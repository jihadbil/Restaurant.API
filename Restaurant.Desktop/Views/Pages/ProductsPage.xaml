<UserControl x:Class="Restaurant.Desktop.Views.Pages.ProductsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Restaurant.Desktop.Views.Pages"
             xmlns:ctrls="clr-namespace:Restaurant.Desktop.Controls"
             xmlns:core="clr-namespace:Restaurant.Desktop.Core"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             FlowDirection="RightToLeft">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Products List Area -->
            <ColumnDefinition Width="*"/>
            <!-- Add / Edit Sidebar Panel -->
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Left / main column -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="المنتجات والأصناف" Style="{StaticResource TextStyle.H1}"/>
                    <TextBlock Text="إدارة قائمة الطعام، الأسعار، والمخزون" Style="{StaticResource TextStyle.Muted}"/>
                </StackPanel>
                <Button Grid.Column="1" 
                        Content="إضافة منتج جديد" 
                        Command="{Binding ShowAddFormCommand}"
                        Style="{StaticResource ButtonStyle.Primary}" 
                        VerticalAlignment="Center"
                        Visibility="{Binding CanManageProducts, Converter={StaticResource BoolToVis}}"/>
            </Grid>

            <!-- Filters Area -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <!-- Search Input -->
                    <ColumnDefinition Width="*"/>
                    <!-- Category Dropdown -->
                    <ColumnDefinition Width="180"/>
                    <!-- Sort Dropdown -->
                    <ColumnDefinition Width="180"/>
                    <!-- View Mode Toggle -->
                    <ColumnDefinition Width="135"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <Border Grid.Column="0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource IconSearch}" Fill="{StaticResource BrushTextMuted}" Stretch="Uniform" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" 
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 BorderThickness="0" 
                                 Background="Transparent"
                                 Padding="0"
                                 Tag="ابحث عن اسم المنتج أو الباركود..."/>
                    </Grid>
                </Border>

                <!-- Category Dropdown Filter -->
                <ComboBox Grid.Column="1" 
                          ItemsSource="{Binding FilterCategories}" 
                          SelectedItem="{Binding SelectedCategoryFilter}"
                          DisplayMemberPath="Name"
                          Tag="تصفية حسب التصنيف"
                          Height="40"
                          Margin="0,0,12,0"/>

                <!-- Sorting Filter -->
                <ComboBox Grid.Column="2" 
                          ItemsSource="{Binding SortOptions}" 
                          SelectedValue="{Binding SelectedSortOption}"
                          SelectedValuePath="Key"
                          DisplayMemberPath="DisplayName"
                          Tag="ترتيب حسب"
                          Height="40"
                          Margin="0,0,12,0"/>

                <!-- View Mode Segmented Control -->
                <Border Grid.Column="3" Background="{StaticResource BrushBackground}" CornerRadius="8" Padding="2" Height="40">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0" Content="قائمة" 
                                     IsChecked="{Binding IsListView, Mode=TwoWay}"
                                     Style="{StaticResource SegmentedRadioButtonStyle}"/>
                        <RadioButton Grid.Column="1" Content="بطاقات" 
                                     IsChecked="{Binding IsCardsView, Mode=TwoWay}"
                                     Style="{StaticResource SegmentedRadioButtonStyle}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Products Container -->
            <Grid Grid.Row="2">
                <!-- Products DataGrid (List View) -->
                <Border Style="{StaticResource CardStyle}" Margin="0"
                        Visibility="{Binding IsListView, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid ItemsSource="{Binding FilteredProducts}" SelectedItem="{Binding SelectedProduct}">
                        <DataGrid.Columns>
                            <!-- Image Column -->
                            <DataGridTemplateColumn Header="الصورة" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="36" Height="36" CornerRadius="6" ClipToBounds="True" Background="#f3f4f6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid>
                                                <Image core:ImageBehavior.ImageUrl="{Binding ImageUrl}" Stretch="UniformToFill"/>
                                                <TextBlock Text="📷" FontSize="14" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding ImageUrl, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=''}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="الباركود" Binding="{Binding BarCode}" Width="110"/>
                            
                            <DataGridTemplateColumn Header="اسم المنتج" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="التصنيف" Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#1038e07b" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CategoryName}" Foreground="{StaticResource BrushPrimary}" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="سعر التكلفة" Binding="{Binding CostPrice, StringFormat={}{0:N2} د.ل}" Width="*"/>
                            
                            <DataGridTemplateColumn Header="سعر البيع" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SalePrice, StringFormat={}{0:N2} د.ل}" Foreground="{StaticResource BrushPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="المربح" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Profit, StringFormat={}{0:N2} د.ل}" Foreground="#10b981" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="نسبة الربح" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProfitPercentage, StringFormat={}{0:F1}%}" Foreground="#10b981" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="الإجراءات" Width="150" Visibility="{Binding DataContext.CanManageProducts, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVis}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="تعديل" 
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource ButtonStyle.Secondary}" 
                                                    Height="28" Padding="10,2" Margin="0,0,8,0" FontSize="11"/>
                                            <Button Content="حذف" 
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding Id}"
                                                    Style="{StaticResource ButtonStyle.Danger}" 
                                                    Height="28" Padding="10,2" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Products Card View -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsCardsView, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListBox ItemsSource="{Binding FilteredProducts}" SelectedItem="{Binding SelectedProduct}"
                             Background="Transparent" BorderThickness="0" Margin="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" Margin="0"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="220" Margin="8" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2" Direction="270"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="120"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Product Image -->
                                        <Border Grid.Row="0" CornerRadius="12,12,0,0" ClipToBounds="True" Background="#f3f4f6">
                                            <Grid>
                                                <Image core:ImageBehavior.ImageUrl="{Binding ImageUrl}" Stretch="Uniform"/>
                                                <TextBlock Text="لا توجد صورة" Style="{StaticResource TextStyle.Muted}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding ImageUrl, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=''}"/>
                                            </Grid>
                                        </Border>

                                        <!-- Product Info -->
                                        <Border Grid.Row="1" Padding="12,10,12,6">
                                            <StackPanel>

                                                <!-- Name -->
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>

                                                <!-- Category Badge -->
                                                <Border Background="#1038e07b" HorizontalAlignment="Left" CornerRadius="4" Padding="6,2" Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding CategoryName}" Foreground="{StaticResource BrushPrimary}" FontSize="10" FontWeight="SemiBold"/>
                                                </Border>
                                                
                                            
                                                <!-- Barcode -->
                                                <TextBlock Text="{Binding BarCode, StringFormat={}الباركود: {0}}" Foreground="{StaticResource BrushTextMuted}" FontSize="10" Margin="0,2,0,0"
                                                           Visibility="{Binding BarCode, Converter={StaticResource StringToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Pricing Info -->
                                        <Border Grid.Row="2" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,1" Margin="12,4" Padding="0,8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Cost -->
                                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,4">
                                                    <TextBlock Text="التكلفة" Foreground="{StaticResource BrushTextMuted}" FontSize="9"/>
                                                    <TextBlock Text="{Binding CostPrice, StringFormat={}{0:N2} د.ل}" Foreground="{StaticResource BrushTextPrimary}" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                
                                                <!-- Sale Price -->
                                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,4">
                                                    <TextBlock Text="سعر البيع" Foreground="{StaticResource BrushTextMuted}" FontSize="9"/>
                                                    <TextBlock Text="{Binding SalePrice, StringFormat={}{0:N2} د.ل}" Foreground="{StaticResource BrushPrimary}" FontSize="11" FontWeight="Bold"/>
                                                </StackPanel>
                                                
                                                <!-- Profit -->
                                                <StackPanel Grid.Row="1" Grid.Column="0">
                                                    <TextBlock Text="المربح" Foreground="{StaticResource BrushTextMuted}" FontSize="9"/>
                                                    <TextBlock Text="{Binding Profit, StringFormat={}{0:N2} د.ل}" Foreground="#10b981" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                
                                                <!-- Profit % -->
                                                <StackPanel Grid.Row="1" Grid.Column="1">
                                                    <TextBlock Text="نسبة المربح" Foreground="{StaticResource BrushTextMuted}" FontSize="9"/>
                                                    <TextBlock Text="{Binding ProfitPercentage, StringFormat={}{0:F1}%}" Foreground="#10b981" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                         <!-- Action Buttons -->
                                         <Grid Grid.Row="3" Margin="12,0,12,12" Visibility="{Binding DataContext.CanManageProducts, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}">
                                             <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <Button Grid.Column="0" Content="تعديل" 
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource ButtonStyle.Secondary}" 
                                                    Height="30" FontSize="11" Padding="0"/>
                                            
                                            <Button Grid.Column="2" Content="حذف" 
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                    CommandParameter="{Binding Id}"
                                                    Style="{StaticResource ButtonStyle.Danger}" 
                                                    Height="30" FontSize="11" Padding="0"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Right Side Panel for Add / Edit -->
        <Border Grid.Column="1" 
                Width="360" 
                Background="{StaticResource BrushSurface}" 
                BorderBrush="{StaticResource BrushBorder}" 
                BorderThickness="1,0,0,0"
                Visibility="{Binding IsFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,24">
                        <TextBlock Text="بيانات المنتج" Style="{StaticResource TextStyle.H3}"/>
                        <Button Command="{Binding CancelFormCommand}" Style="{StaticResource ButtonStyle.Secondary}" Width="30" Height="30" Padding="0" HorizontalAlignment="Right">
                            <Path Data="{StaticResource IconClose}" Fill="{StaticResource BrushTextPrimary}" Stretch="Uniform" Width="10" Height="10"/>
                        </Button>
                    </Grid>

                    <!-- Form Inputs -->
                    <StackPanel Grid.Row="1">
                        <!-- Barcode -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="الباركود (اختياري)" Style="{StaticResource TextStyle.Label}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding FormBarCode, UpdateSourceTrigger=PropertyChanged}" Height="38"/>
                        </StackPanel>

                        <!-- Name -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="اسم المنتج" Style="{StaticResource TextStyle.Label}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" Height="38"/>
                        </StackPanel>

                        <!-- Description -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="الوصف" Style="{StaticResource TextStyle.Label}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                        </StackPanel>

                        <!-- Category -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="التصنيف" Style="{StaticResource TextStyle.Label}" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding Categories}" 
                                      SelectedValue="{Binding FormCategoryId}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name" 
                                      Height="38"/>
                        </StackPanel>

                        <!-- Cost Price & Sale Price side-by-side -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="سعر التكلفة" Style="{StaticResource TextStyle.Label}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding FormCostPrice, UpdateSourceTrigger=PropertyChanged}" Height="38"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="سعر البيع" Style="{StaticResource TextStyle.Label}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding FormSalePrice, UpdateSourceTrigger=PropertyChanged}" Height="38"/>
                            </StackPanel>
                        </Grid>

                        <!-- Image Upload & Preview -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="صورة المنتج" Style="{StaticResource TextStyle.Label}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding FormImageUrl, UpdateSourceTrigger=PropertyChanged}" Height="38" IsReadOnly="True" VerticalContentAlignment="Center" Background="#f3f4f6"/>
                                <Button Grid.Column="1" Content="رفع صورة" Command="{Binding SelectImageCommand}" Style="{StaticResource ButtonStyle.Primary}" Height="38" Margin="8,0,0,0" Padding="12,0"/>
                            </Grid>
                            
                            <!-- Preview Image -->
                            <Border Margin="0,10,0,0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Height="120" Background="#f9fafb" ClipToBounds="True">
                                <Grid>
                                     <Image core:ImageBehavior.ImageUrl="{Binding FormImageUrl}" Stretch="Uniform"/>
                                     <TextBlock Text="لا توجد صورة للمعاينة" Style="{StaticResource TextStyle.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding FormImageUrl, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=''}"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Form Error Display -->
                        <Border Background="#10ef4444" CornerRadius="8" Padding="12,10" Margin="0,0,0,20" 
                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource TextStyle.Muted}" Foreground="{StaticResource BrushDanger}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <!-- Actions -->
                    <StackPanel Grid.Row="2">
                        <Button Content="حفظ المنتج" 
                                Command="{Binding SaveCommand}" 
                                Style="{StaticResource ButtonStyle.Primary}" 
                                Height="42" Margin="0,0,0,10"/>
                        <Button Content="إلغاء" 
                                Command="{Binding CancelFormCommand}" 
                                Style="{StaticResource ButtonStyle.Secondary}" 
                                Height="40"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Loading Overlay -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Background="#50ffffff" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ctrls:LoadingSpinner/>
        </Grid>
    </Grid>
</UserControl>
