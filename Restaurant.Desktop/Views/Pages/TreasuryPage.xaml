<UserControl x:Class="Restaurant.Desktop.Views.Pages.TreasuryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Restaurant.Desktop.Views.Pages"
             xmlns:ctrls="clr-namespace:Restaurant.Desktop.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             FlowDirection="RightToLeft">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Main Ledger View -->
            <ColumnDefinition Width="*"/>
            <!-- Manual Inflow/Outflow Sidebar -->
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Main Ledger Section -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="حركات درج النقود والخزينة" Style="{StaticResource TextStyle.H1}"/>
                    <TextBlock Text="متابعة التدفقات المالية والمقبوضات والمصروفات النقدية" Style="{StaticResource TextStyle.Muted}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="إيداع نقدي يدوي" 
                            Command="{Binding ShowManualInflowFormCommand}"
                            Style="{StaticResource ButtonStyle.Primary}" 
                            Background="#ff2196f3"
                            BorderBrush="#ff2196f3"
                            Margin="0,0,8,0"/>
                    <Button Content="سحب نقدي يدوي" 
                            Command="{Binding ShowManualOutflowFormCommand}"
                            Style="{StaticResource ButtonStyle.Danger}" 
                            Background="#fff44336"
                            BorderBrush="#fff44336"/>
                </StackPanel>
            </Grid>

            <!-- Filter Panel -->
            <Border Grid.Row="1" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cashbox Selector -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="الخزينة المستهدفة" Style="{StaticResource TextStyle.Label}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Cashboxes}"
                                  SelectedValue="{Binding FilterCashboxId}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="Name"
                                  Height="38"/>
                    </StackPanel>

                    <!-- From Date -->
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="تاريخ البداية" Style="{StaticResource TextStyle.Label}" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding FilterFrom}" Height="38" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- To Date -->
                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="تاريخ النهاية" Style="{StaticResource TextStyle.Label}" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding FilterTo}" Height="38" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Search Button -->
                    <Button Grid.Column="3" 
                            Content="تحديث" 
                            Command="{Binding ApplyFiltersCommand}"
                            Style="{StaticResource ButtonStyle.Secondary}"
                            Height="38" 
                            Padding="16,0"
                            VerticalAlignment="Bottom"/>
                </Grid>
            </Border>

            <!-- Summary Cards Dashboard -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Inflow -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="إجمالي المقبوضات والإيداعات" Style="{StaticResource TextStyle.Muted}" FontSize="12"/>
                        <TextBlock Text="{Binding TotalInflow, StringFormat={}{0:N2} د.ل}" Style="{StaticResource TextStyle.H2}" Foreground="#ff38e07b" FontWeight="Bold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Total Outflow -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,12,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="إجمالي المدفوعات والمسحوبات" Style="{StaticResource TextStyle.Muted}" FontSize="12"/>
                        <TextBlock Text="{Binding TotalOutflow, StringFormat={}{0:N2} د.ل}" Style="{StaticResource TextStyle.H2}" Foreground="#fff44336" FontWeight="Bold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Net Balance -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="صافي حركات الصندوق" Style="{StaticResource TextStyle.Muted}" FontSize="12"/>
                        <TextBlock Text="{Binding NetBalance, StringFormat={}{0:N2} د.ل}" Style="{StaticResource TextStyle.H2}" Foreground="{StaticResource BrushPrimary}" FontWeight="Bold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Entries DataGrid -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0">
                <DataGrid ItemsSource="{Binding Entries}" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المعرف" Binding="{Binding Id}" Width="80"/>
                        <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding Date, StringFormat={}{0:yyyy/MM/dd HH:mm}}" Width="150"/>
                        
                        <!-- Type badge with data triggers -->
                        <DataGridTemplateColumn Header="النوع" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1538e07b"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EntryType}" Value="SalePayment">
                                                        <Setter Property="Background" Value="#1538e07b"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EntryType}" Value="Inflow">
                                                        <Setter Property="Background" Value="#152196f3"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EntryType}" Value="Outflow">
                                                        <Setter Property="Background" Value="#15f44336"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontWeight="Bold" FontSize="11" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#ff38e07b"/>
                                                    <Setter Property="Text" Value="مبيعات"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EntryType}" Value="SalePayment">
                                                            <Setter Property="Foreground" Value="#ff38e07b"/>
                                                            <Setter Property="Text" Value="دفع طلب مبيعات"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EntryType}" Value="Inflow">
                                                            <Setter Property="Foreground" Value="#ff2196f3"/>
                                                            <Setter Property="Text" Value="إيداع يدوي"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EntryType}" Value="Outflow">
                                                            <Setter Property="Foreground" Value="#fff44336"/>
                                                            <Setter Property="Text" Value="سحب يدوي"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="100"/>
                        <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethodName}" Width="110"/>
                        <DataGridTextColumn Header="رقم الطلب" Binding="{Binding OrderNumber}" Width="100"/>
                        <DataGridTextColumn Header="المستخدم" Binding="{Binding UserName}" Width="120"/>
                        <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="2*"/>
                        
                        <DataGridTemplateColumn Header="الإجراءات" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="حذف" 
                                            Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding Id}"
                                            Style="{StaticResource ButtonStyle.Danger}" 
                                            Height="28" Padding="10,2" FontSize="11"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Sidebar Panel for Manual Inflow / Outflow -->
        <Border Grid.Column="1" 
                Width="340" 
                Background="{StaticResource BrushSurface}" 
                BorderBrush="{StaticResource BrushBorder}" 
                BorderThickness="1,0,0,0"
                Visibility="{Binding IsManualEntryFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Text="{Binding ManualEntryTitle}" Style="{StaticResource TextStyle.H3}"/>
                    <Button Command="{Binding CancelManualEntryCommand}" Style="{StaticResource ButtonStyle.Secondary}" Width="30" Height="30" Padding="0" HorizontalAlignment="Left">
                        <Path Data="{StaticResource IconClose}" Fill="{StaticResource BrushTextPrimary}" Stretch="Uniform" Width="10" Height="10"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Amount -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="المبلغ المالي" Style="{StaticResource TextStyle.Label}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding ManualEntryAmount, UpdateSourceTrigger=PropertyChanged}" Height="40" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Notes -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="الملاحظات والتبرير" Style="{StaticResource TextStyle.Label}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding ManualEntryNotes}" Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>
                        </StackPanel>

                        <!-- Form Error Display -->
                        <Border Background="#10ef4444" CornerRadius="8" Padding="12,10" Margin="0,0,0,20" 
                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource TextStyle.Muted}" Foreground="{StaticResource BrushDanger}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2">
                    <Button Content="تأكيد الحركة وحفظ" 
                            Command="{Binding SaveManualEntryCommand}" 
                            Style="{StaticResource ButtonStyle.Primary}" 
                            Height="42" Margin="0,0,0,10"/>
                    <Button Content="إلغاء" 
                            Command="{Binding CancelManualEntryCommand}" 
                            Style="{StaticResource ButtonStyle.Secondary}" 
                            Height="40"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Background="#50ffffff" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ctrls:LoadingSpinner/>
        </Grid>
    </Grid>
</UserControl>
