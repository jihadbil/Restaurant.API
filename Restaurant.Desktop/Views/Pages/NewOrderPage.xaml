<UserControl x:Class="Restaurant.Desktop.Views.Pages.NewOrderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Restaurant.Desktop.Views.Pages"
             xmlns:ctrls="clr-namespace:Restaurant.Desktop.Controls"
             xmlns:enums="clr-namespace:Restaurant.Models.Enums;assembly=Restaurant.Models"
             xmlns:core="clr-namespace:Restaurant.Desktop.Core"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             FlowDirection="RightToLeft">

    <UserControl.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding ResetCartCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- Product Card Template (Premium UI) -->
        <DataTemplate x:Key="ProductCardTemplate">
            <Border Width="165" 
                    Height="210"
                    CornerRadius="12" 
                    Background="{StaticResource BrushSurface}" 
                    Margin="0,0,10,10" 
                    BorderThickness="1" 
                    BorderBrush="{StaticResource BrushBorder}">
                <!-- Hover animations & style triggers -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="8" ShadowDepth="2" Direction="270"/>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid Cursor="Hand" MouseLeftButtonUp="ProductCard_Click">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="125"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <!-- Image Container with clip to match card rounded corners -->
                        <Border CornerRadius="11,11,0,0" ClipToBounds="True" Background="{StaticResource BrushNeutral50}">
                            <Grid>
                                <Image core:ImageBehavior.ImageUrl="{Binding ImageUrl}" 
                                       Stretch="UniformToFill" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                                <!-- Fallback path in case image fails to load -->
                                <Path Data="{StaticResource IconProducts}" Fill="{StaticResource BrushTextMuted}" Stretch="Uniform" Width="36" Height="36" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="{Binding ImageUrl, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=''}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="10,8,10,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Product Name -->
                        <TextBlock Grid.Row="0"
                                   Text="{Binding Name}" 
                                   FontFamily="{StaticResource CairoFont}"
                                   FontWeight="SemiBold" 
                                   FontSize="13" 
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   VerticalAlignment="Top"/>
                        <!-- Price Tag -->
                        <Border Grid.Row="1" Background="{StaticResource BrushPrimaryBg}" CornerRadius="6" HorizontalAlignment="Right" Padding="6,3" Margin="0,4,0,0">
                            <TextBlock Text="{Binding SalePrice, StringFormat={}{0:0.00} د.ل}" 
                                       FontFamily="{StaticResource CairoFont}"
                                       FontSize="11.5" 
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushSuccessText}"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Order Item Template (Premium UI) -->
        <DataTemplate x:Key="OrderItemTemplate">
            <Border Background="{StaticResource BrushSurface}" 
                    CornerRadius="12" 
                    Padding="12" 
                    Margin="0,0,0,10"
                    BorderThickness="1"
                    BorderBrush="{StaticResource BrushBorder}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="#000000" Opacity="0.03" BlurRadius="6" ShadowDepth="1" Direction="270"/>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Style>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Column 0: Product Image -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Column 1: Product Name, Price, Quantity & Note -->
                        <ColumnDefinition Width="*"/>
                        <!-- Column 2: Total Price & Actions -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Product Image -->
                    <Border Grid.Column="0" 
                            Width="64" 
                            Height="64" 
                            CornerRadius="8" 
                            ClipToBounds="True"
                            Background="{StaticResource BrushNeutral50}"
                            BorderThickness="1"
                            BorderBrush="{StaticResource BrushBorder}"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <Grid>
                            <Image core:ImageBehavior.ImageUrl="{Binding ImageUrl}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Path Data="{StaticResource IconProducts}" Fill="{StaticResource BrushTextMuted}" Stretch="Uniform" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="{Binding ImageUrl, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=''}"/>
                        </Grid>
                    </Border>

                    <!-- Product Details and Quantity -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <!-- Product Name -->
                        <TextBlock Text="{Binding ProductName}" 
                                   FontFamily="{StaticResource CairoFont}"
                                   FontWeight="Bold" 
                                   FontSize="14"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   TextTrimming="CharacterEllipsis"/>
                        
                        <!-- Unit Price -->
                        <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:0.00} د.ل}" 
                                   FontFamily="{StaticResource CairoFont}"
                                   FontSize="12" 
                                   Foreground="{StaticResource BrushTextMuted}"
                                   Margin="0,2,0,8"/>

                        <!-- Quantity Selector (Pill Style) -->
                        <Border Background="{StaticResource BrushNeutral100}" 
                                CornerRadius="15" 
                                Height="30" 
                                HorizontalAlignment="Right" 
                                VerticalAlignment="Center"
                                Padding="4,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Decrease button -->
                                <Button Width="24" Height="24" 
                                        Background="Transparent" 
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="DecreaseQuantity_Click"
                                        VerticalAlignment="Center">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="Transparent" CornerRadius="12" SnapsToDevicePixels="True">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource BrushNeutral200}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource BrushNeutral300}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="-" FontSize="16" FontWeight="Bold" Foreground="#374151" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                </Button>

                                <!-- Quantity text -->
                                <TextBlock Text="{Binding Quantity}" 
                                           FontFamily="{StaticResource CairoFont}"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           Margin="10,0" 
                                           MinWidth="18"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <!-- Increase button -->
                                <Button Width="24" Height="24" 
                                        Background="Transparent" 
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="IncreaseQuantity_Click"
                                        VerticalAlignment="Center">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="Transparent" CornerRadius="12" SnapsToDevicePixels="True">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource BrushNeutral200}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource BrushNeutral300}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="+" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushNeutral700}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Excluded Addons Box (Only visible if item notes are set) -->
                        <Border x:Name="NoteContainer"
                                Background="{StaticResource BrushWarningBg}" 
                                BorderBrush="{StaticResource BrushWarningBorder}"
                                BorderThickness="1"
                                CornerRadius="6" 
                                Padding="8,6" 
                                Margin="0,8,0,0"
                                HorizontalAlignment="Right">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Notes}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Notes}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Notes}" Value="لا يوجد ملاحظات">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconNote}" Fill="{StaticResource BrushWarningText}" Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblnote" 
                                           Text="{Binding Notes}" 
                                           FontFamily="{StaticResource CairoFont}"
                                           FontSize="11.5" 
                                           Foreground="{StaticResource BrushWarningText}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right Column: Total Price and Actions -->
                    <Grid Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Line Item Total -->
                        <TextBlock Grid.Row="0"
                                   Text="{Binding LineTotal, StringFormat={}{0:0.00} د.ل}" 
                                   FontFamily="{StaticResource CairoFont}"
                                   FontWeight="Bold" 
                                   FontSize="15" 
                                   Foreground="{StaticResource BrushPrimary}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Margin="0,4,0,0"/>

                        <!-- Action Buttons Row -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,4">
                            <!-- Edit Button -->
                            <Button x:Name="btnedit"
                                    Width="32" 
                                    Height="32"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Margin="0,0,8,0"
                                    Click="btnedit_Click"
                                    Cursor="Hand"
                                    ToolTip="تعديل الملاحظات والإضافات">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" Background="Transparent" CornerRadius="16" SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource BrushInfoBg}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource BrushInfoHover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1.003 1.003 0 0 0 0-1.42l-2.34-2.34a1.003 1.003 0 0 0-1.42 0l-1.83 1.83 3.75 3.75 1.84-1.82z"
                                      Fill="{StaticResource BrushInfo}"
                                      Width="16" 
                                      Height="16"
                                      Stretch="Uniform"/>
                            </Button>

                            <!-- Delete Button -->
                            <Button Width="32" 
                                    Height="32"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="DeleteItem_Click" 
                                    Cursor="Hand"
                                    ToolTip="حذف الصنف من السلة"
                                    Visibility="{Binding DataContext.CanVoidItem, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" Background="Transparent" CornerRadius="16" SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource BrushDangerBg}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource BrushDangerHover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zm3.46-8.12L9.46 17h1.08l.01-6.12H9.46zM15 17h1.09l-.01-6.12H15V17zM15.5 4l-1-1h-5l-1 1H5v2h14V4h-3.5z"
                                      Fill="{StaticResource BrushDanger}"
                                      Stretch="Uniform"
                                      Width="16" 
                                      Height="16"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Column 0: Product Browser (Right side) -->
            <ColumnDefinition Width="3*"/>
            <!-- Column 1: Order Basket (Left side) -->
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Right Side: Product Catalog (Column 0) -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="إنشاء طلب جديد (POS)" Style="{StaticResource TextStyle.H1}"/>
                    <TextBlock Text="أضف الأصناف للسلة لإرسال طلب البيع مباشرة" Style="{StaticResource TextStyle.Muted}"/>
                </StackPanel>
            </Grid>

            <!-- Categories Horizontal Filter Bar -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <!-- 'All' Tab Button -->
                    <RadioButton Content="الكل" 
                                 IsChecked="True" 
                                 Style="{StaticResource SegmentedRadioButtonStyle}" 
                                 Command="{Binding LoadDataCommand}"
                                 Click="CategoryFilter_Click" 
                                 Tag="All"/>
                    
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Content="{Binding Name}" 
                                             Style="{StaticResource SegmentedRadioButtonStyle}" 
                                             Click="CategoryFilter_Click"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Products Catalog Grid -->
            <Grid Grid.Row="2">
                <ListBox ItemsSource="{Binding FilteredProducts}" ItemTemplate="{StaticResource ProductCardTemplate}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCatalogEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Margin="0,-6"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <ctrls:EmptyState Title="لا توجد أصناف في هذا القسم" 
                                  Subtitle="لا توجد منتجات مسجلة في هذا التصنيف حالياً. يرجى إضافة منتجات في إعدادات كتالوج الأصناف."
                                  Icon="{StaticResource IconProducts}">
                    <ctrls:EmptyState.Style>
                        <Style TargetType="UserControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCatalogEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ctrls:EmptyState.Style>
                </ctrls:EmptyState>
            </Grid>
        </Grid>

        <!-- Left Side: Order Basket & Checkout (Column 1) -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Cart Header (Title + Clear button) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Cart Items List -->
                    <RowDefinition Height="*"/>
                    <!-- Bill Summary Section -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Basket Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="سلة المشتريات" Style="{StaticResource TextStyle.H3}"/>
                        <TextBlock Text="{Binding OrderNumber, StringFormat={}رقم الطلب المقترح: {0}}" Style="{StaticResource TextStyle.Muted}"/>
                    </StackPanel>
                    <Button Content="مسح السلة" 
                            Command="{Binding ResetCartCommand}"
                            Style="{StaticResource ButtonStyle.Danger}" 
                            Height="28" Padding="10,2" FontSize="11" HorizontalAlignment="Right"/>
                </Grid>

                <!-- Basket Items List Table -->
                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCartEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl ItemsSource="{Binding CartItems}" ItemTemplate="{StaticResource OrderItemTemplate}"/>
                    </ScrollViewer>
                    
                    <ctrls:EmptyState Title="سلة المشتريات فارغة" 
                                      Subtitle="اضغط على المنتجات في الكتالوج لإضافتها وتجهيز الفاتورة."
                                      Icon="{StaticResource IconNote}">
                        <ctrls:EmptyState.Style>
                            <Style TargetType="UserControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCartEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ctrls:EmptyState.Style>
                    </ctrls:EmptyState>
                </Grid>

                <!-- Bill Totals & Checkout Actions -->
                <Border Grid.Row="2" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,8,0,0">
                    <StackPanel>
                        <!-- Discount Input -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="الخصم المباشر (د.ل)" Style="{StaticResource TextStyle.Label}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" IsEnabled="{Binding CanApplyDiscount}"/>
                        </Grid>

                        <!-- Order Type (Indoor/Outdoor/Delivery) RadioButtons -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="نوع الطلب" Style="{StaticResource TextStyle.Label}" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0" Content="محلي (صالات)" Style="{StaticResource CardRadioButtonStyle}" core:IconBehavior.Icon="{StaticResource IconIndoor}" Tag="Indoor" IsChecked="True" Checked="OrderType_Checked"/>
                                <RadioButton Grid.Column="1" Content="سفري (تيك أواي)" Style="{StaticResource CardRadioButtonStyle}" core:IconBehavior.Icon="{StaticResource IconOutdoor}" Tag="Outdoor" Checked="OrderType_Checked"/>
                                <RadioButton Grid.Column="2" Content="توصيل للمنزل" Style="{StaticResource CardRadioButtonStyle}" core:IconBehavior.Icon="{StaticResource IconDelivery}" Tag="Delivery" Checked="OrderType_Checked"/>
                            </Grid>
                        </StackPanel>

                        <Separator Background="{StaticResource BrushBorder}" Margin="0,0,0,10"/>

                        <!-- SubTotal & Final Total display -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="المجموع الفرعي:" Style="{StaticResource TextStyle.Muted}"/>
                            <TextBlock Text="{Binding SubTotal, StringFormat={}{0:N2} د.ل}" Style="{StaticResource TextStyle.Body}" HorizontalAlignment="Right"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="الإجمالي المستحق:" Style="{StaticResource TextStyle.Label}" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Total, StringFormat={}{0:N2} د.ل}" Style="{StaticResource TextStyle.H2}" Foreground="{StaticResource BrushPrimary}" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>

                        <Separator Background="{StaticResource BrushBorder}" Margin="0,0,0,8"/>

                        <!-- Payment Methods Horizontal Scrollable Bar -->
                        <TextBlock Text="طريقة الدفع (اضغط للدفع والتأكيد)" Style="{StaticResource TextStyle.Label}" FontSize="12.5" Margin="0,2,0,6"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,4">
                            <ItemsControl ItemsSource="{Binding PaymentMethods}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ConfirmOrderWithPaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Width="95" Height="78" 
                                                Margin="0,0,8,4" 
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="btnBorder" 
                                                            Background="{StaticResource BrushSurface}" 
                                                            BorderBrush="{StaticResource BrushBorder}" 
                                                            BorderThickness="1.5" 
                                                            CornerRadius="8" 
                                                            SnapsToDevicePixels="True">
                                                        <Grid Margin="2">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            
                                                            <!-- Logo Area -->
                                                            <Border Grid.Row="0" Margin="2" CornerRadius="4" ClipToBounds="True" Background="{StaticResource BrushNeutral50}" VerticalAlignment="Center" HorizontalAlignment="Center" Height="36" Width="36">
                                                                <Grid>
                                                                    <!-- Logo image -->
                                                                    <Image core:ImageBehavior.ImageUrl="{Binding LogoUrl, Converter={StaticResource ImageUrlConverter}}" Stretch="Uniform"/>
                                                                    <!-- Fallback Icon if LogoUrl is null or empty -->
                                                                    <Path Data="{StaticResource IconCard}" Fill="{StaticResource BrushTextMuted}" Stretch="Uniform" Width="20" Height="20"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                          Visibility="{Binding LogoUrl, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                                </Grid>
                                                            </Border>
                                                            
                                                            <!-- Method Name -->
                                                            <TextBlock Grid.Row="1" Text="{Binding Name}" 
                                                                       FontFamily="{StaticResource CairoFont}" 
                                                                       FontSize="11" 
                                                                       FontWeight="SemiBold" 
                                                                       Foreground="{StaticResource BrushTextPrimary}" 
                                                                       TextAlignment="Center" 
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,2,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                                                            <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource BrushPrimaryLight}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource BrushPrimaryLighter}"/>
                                                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Loading Overlay (Spans both columns) -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Background="#50ffffff" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ctrls:LoadingSpinner/>
        </Grid>
    </Grid>
</UserControl>
