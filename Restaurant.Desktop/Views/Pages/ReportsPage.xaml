<UserControl x:Class="Restaurant.Desktop.Views.Pages.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Restaurant.Desktop.Views.Pages"
             xmlns:ctrls="clr-namespace:Restaurant.Desktop.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             FlowDirection="RightToLeft">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header (Title + Global Dates) -->
            <RowDefinition Height="Auto"/>
            <!-- Report Tabs Header Selector -->
            <RowDefinition Height="Auto"/>
            <!-- Active Report Tab Data grid -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <TextBlock Text="التقارير التفصيلية" Style="{StaticResource TextStyle.H1}"/>
                <TextBlock Text="استعراض أداء المبيعات، الفئات، طرق الدفع والعمليات الملغاة بالتفصيل" Style="{StaticResource TextStyle.Muted}"/>
            </StackPanel>

            <!-- Global Date Filter Panel -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="من:" Style="{StaticResource TextStyle.Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker SelectedDate="{Binding StartDate}" Width="120" Height="36" VerticalContentAlignment="Center"/>
                
                <TextBlock Text="إلى:" Style="{StaticResource TextStyle.Label}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <DatePicker SelectedDate="{Binding EndDate}" Width="120" Height="36" VerticalContentAlignment="Center"/>

                <Button Content="طباعة التقرير" 
                        Click="BtnPrint_Click"
                        Style="{StaticResource ButtonStyle.Primary}" 
                        Height="36" Margin="12,0,0,0" Padding="16,0"/>
            </StackPanel>
        </Grid>

        <!-- Tab Selection Header Segmented Control -->
        <Border Grid.Row="1" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="المبيعات اليومية" IsChecked="True" Style="{StaticResource SegmentedRadioButtonStyle}" Command="{Binding ChangeTabCommand}" CommandParameter="Sales"/>
                <RadioButton Content="الأصناف الأكثر مبيعاً" Style="{StaticResource SegmentedRadioButtonStyle}" Command="{Binding ChangeTabCommand}" CommandParameter="Products"/>
                <RadioButton Content="التصنيفات الأكثر مبيعاً" Style="{StaticResource SegmentedRadioButtonStyle}" Command="{Binding ChangeTabCommand}" CommandParameter="Categories"/>
                <RadioButton Content="وسائل الدفع" Style="{StaticResource SegmentedRadioButtonStyle}" Command="{Binding ChangeTabCommand}" CommandParameter="PaymentMethods"/>
                <RadioButton Content="الطلبات الملغاة" Style="{StaticResource SegmentedRadioButtonStyle}" Command="{Binding ChangeTabCommand}" CommandParameter="Cancelled"/>
            </StackPanel>
        </Border>

        <!-- Active Tab Panels Area -->
        <Grid Grid.Row="2">
            <!-- 1. Sales Tab Grid view -->
            <Border Style="{StaticResource CardStyle}" Margin="0" Visibility="{Binding ActiveTab, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Sales}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" ItemsSource="{Binding DailySales}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat={}{0:yyyy/MM/dd}}" Width="1.5*"/>
                            <DataGridTextColumn Header="عدد الطلبات المنجزة" Binding="{Binding TotalOrders}" Width="*"/>
                            <DataGridTextColumn Header="إجمالي المبيعات" Binding="{Binding TotalSales, StringFormat={}{0:N2} د.ل}" Width="1.5*"/>
                            <DataGridTextColumn Header="التكلفة الإجمالية" Binding="{Binding TotalCost, StringFormat={}{0:N2} د.ل}" Width="1.5*"/>
                            <DataGridTextColumn Header="الأرباح المحققة" Binding="{Binding TotalProfit, StringFormat={}{0:N2} د.ل}" Width="1.5*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="1" Background="{StaticResource BrushBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="المجموع الإجمالي:" FontWeight="Bold" Style="{StaticResource TextStyle.Body}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding SalesTotalOrders}" FontWeight="Bold" Style="{StaticResource TextStyle.Body}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding SalesTotalSales, StringFormat={}{0:N2} د.ل}" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" Style="{StaticResource TextStyle.Body}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding SalesTotalCost, StringFormat={}{0:N2} د.ل}" FontWeight="Bold" Style="{StaticResource TextStyle.Body}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="{Binding SalesTotalProfit, StringFormat={}{0:N2} د.ل}" FontWeight="Bold" Foreground="#ff38e07b" Style="{StaticResource TextStyle.Body}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 2. Products Tab Grid view -->
            <Border Style="{StaticResource CardStyle}" Margin="0" Visibility="{Binding ActiveTab, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Products}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" ItemsSource="{Binding BestProducts}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="المنتج" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="الباركود" Binding="{Binding BarCode}" Width="120"/>
                            <DataGridTextColumn Header="الكمية المباعة" Binding="{Binding QuantitySold}" Width="*"/>
                            <DataGridTextColumn Header="إجمالي الإيرادات" Binding="{Binding TotalRevenue, StringFormat={}{0:N2} د.ل}" Width="1.5*"/>
                            <DataGridTextColumn Header="التكلفة الإجمالية" Binding="{Binding TotalCost, StringFormat={}{0:N2} د.ل}" Width="1.5*"/>
                            <DataGridTextColumn Header="صافي الأرباح" Binding="{Binding TotalProfit, StringFormat={}{0:N2} د.ل}" Width="1.5*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="1" Background="{StaticResource BrushBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="المجموع الإجمالي:" FontWeight="Bold" Style="{StaticResource TextStyle.Body}" VerticalAlignment="Center"/>
                            <!-- Barcode empty -->
                            <TextBlock Grid.Column="2" Text="{Binding ProductsTotalQuantity}" FontWeight="Bold" Style="{StaticResource TextStyle.Body}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding ProductsTotalRevenue, StringFormat={}{0:N2} د.ل}" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" Style="{StaticResource TextStyle.Body}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="{Binding ProductsTotalCost, StringFormat={}{0:N2} د.ل}" FontWeight="Bold" Style="{StaticResource TextStyle.Body}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="{Binding ProductsTotalProfit, StringFormat={}{0:N2} د.ل}" FontWeight="Bold" Foreground="#ff38e07b" Style="{StaticResource TextStyle.Body}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 3. Categories Tab Grid view -->
            <Border Style="{StaticResource CardStyle}" Margin="0" Visibility="{Binding ActiveTab, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Categories}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" ItemsSource="{Binding BestCategories}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="اسم التصنيف" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="الكمية المباعة" Binding="{Binding QuantitySold}" Width="*"/>
                            <DataGridTextColumn Header="إجمالي المبيعات" Binding="{Binding TotalRevenue, StringFormat={}{0:N2} د.ل}" Width="1.5*"/>
                            <DataGridTextColumn Header="التكلفة الإجمالية" Binding="{Binding TotalCost, StringFormat={}{0:N2} د.ل}" Width="1.5*"/>
                            <DataGridTextColumn Header="صافي الأرباح" Binding="{Binding TotalProfit, StringFormat={}{0:N2} د.ل}" Width="1.5*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="1" Background="{StaticResource BrushBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="المجموع الإجمالي:" FontWeight="Bold" Style="{StaticResource TextStyle.Body}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding CategoriesTotalQuantity}" FontWeight="Bold" Style="{StaticResource TextStyle.Body}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding CategoriesTotalRevenue, StringFormat={}{0:N2} د.ل}" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" Style="{StaticResource TextStyle.Body}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding CategoriesTotalCost, StringFormat={}{0:N2} د.ل}" FontWeight="Bold" Style="{StaticResource TextStyle.Body}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="{Binding CategoriesTotalProfit, StringFormat={}{0:N2} د.ل}" FontWeight="Bold" Foreground="#ff38e07b" Style="{StaticResource TextStyle.Body}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 4. PaymentMethods Tab Grid view -->
            <Border Style="{StaticResource CardStyle}" Margin="0" Visibility="{Binding ActiveTab, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=PaymentMethods}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" ItemsSource="{Binding PaymentMethods}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="وسيلة الدفع" Binding="{Binding PaymentMethodName}" Width="2*"/>
                            <DataGridTextColumn Header="عدد العمليات" Binding="{Binding TotalOrders}" Width="*"/>
                            <DataGridTextColumn Header="إجمالي القيمة المحصلة" Binding="{Binding TotalSales, StringFormat={}{0:N2} د.ل}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="1" Background="{StaticResource BrushBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="المجموع الإجمالي:" FontWeight="Bold" Style="{StaticResource TextStyle.Body}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding PaymentMethodsTotalOrders}" FontWeight="Bold" Style="{StaticResource TextStyle.Body}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding PaymentMethodsTotalSales, StringFormat={}{0:N2} د.ل}" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" Style="{StaticResource TextStyle.Body}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 5. Cancelled Tab Grid view -->
            <Border Style="{StaticResource CardStyle}" Margin="0" Visibility="{Binding ActiveTab, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Cancelled}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" ItemsSource="{Binding CancelledOrders}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم الطلب" Binding="{Binding OrderNumber}" Width="100"/>
                            <DataGridTextColumn Header="تاريخ الطلب" Binding="{Binding Date, StringFormat={}{0:yyyy/MM/dd HH:mm}}" Width="150"/>
                            <DataGridTextColumn Header="قيمة الطلب الملغى" Binding="{Binding Total, StringFormat={}{0:N2} د.ل}" Width="120"/>
                            <DataGridTextColumn Header="الكاشير المسؤول" Binding="{Binding UserName}" Width="120"/>
                            <DataGridTextColumn Header="سبب الإلغاء / ملاحظات" Binding="{Binding Notes}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="1" Background="{StaticResource BrushBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="المجموع الإجمالي:" FontWeight="Bold" Style="{StaticResource TextStyle.Body}" VerticalAlignment="Center"/>
                            <!-- Date empty -->
                            <TextBlock Grid.Column="2" Text="{Binding CancelledTotal, StringFormat={}{0:N2} د.ل}" FontWeight="Bold" Foreground="{StaticResource BrushDanger}" Style="{StaticResource TextStyle.Body}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Loading Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#50ffffff" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ctrls:LoadingSpinner/>
        </Grid>
    </Grid>
</UserControl>
