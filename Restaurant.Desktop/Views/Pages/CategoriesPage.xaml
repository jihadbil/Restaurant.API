<UserControl x:Class="Restaurant.Desktop.Views.Pages.CategoriesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Restaurant.Desktop.Views.Pages"
             xmlns:ctrls="clr-namespace:Restaurant.Desktop.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             FlowDirection="RightToLeft">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Categories List Grid Area -->
            <ColumnDefinition Width="*"/>
            <!-- Add / Edit Sidebar (Flyout style) -->
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Categories List Column -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="التصنيفات" Style="{StaticResource TextStyle.H1}"/>
                    <TextBlock Text="إدارة تصنيفات المنتجات والأقسام الرئيسية" Style="{StaticResource TextStyle.Muted}"/>
                </StackPanel>
                <Button Grid.Column="1" 
                        Content="إضافة تصنيف جديد" 
                        Command="{Binding ShowAddFormCommand}"
                        Style="{StaticResource ButtonStyle.Primary}" 
                        VerticalAlignment="Center"
                        Visibility="{Binding CanManageCategories, Converter={StaticResource BoolToVis}}"/>
            </Grid>

            <!-- Search & View Switcher Area -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="135"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <Border Grid.Column="0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource IconSearch}" Fill="{StaticResource BrushTextMuted}" Stretch="Uniform" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" 
                                  Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                  BorderThickness="0" 
                                  Background="Transparent"
                                  Padding="0"
                                  Tag="ابحث عن تصنيف..."/>
                    </Grid>
                </Border>

                <!-- View Mode Segmented Control -->
                <Border Grid.Column="2" Background="{StaticResource BrushBackground}" CornerRadius="8" Padding="2" Height="40">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0" Content="قائمة" 
                                     IsChecked="{Binding IsListView, Mode=TwoWay}"
                                     Style="{StaticResource SegmentedRadioButtonStyle}"/>
                        <RadioButton Grid.Column="1" Content="بطاقات" 
                                     IsChecked="{Binding IsCardsView, Mode=TwoWay}"
                                     Style="{StaticResource SegmentedRadioButtonStyle}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Categories Container -->
            <Grid Grid.Row="2">
                <!-- Categories DataGrid (List View) -->
                <Border Style="{StaticResource CardStyle}" Margin="0"
                        Visibility="{Binding IsListView, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid ItemsSource="{Binding FilteredCategories}" SelectedItem="{Binding SelectedCategory}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="المعرف" Binding="{Binding Id}" Width="100"/>
                            
                            <DataGridTemplateColumn Header="اسم التصنيف" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="الإجراءات" Width="150" Visibility="{Binding DataContext.CanManageCategories, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVis}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="تعديل" 
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource ButtonStyle.Secondary}" 
                                                    Height="28" Padding="10,2" Margin="0,0,8,0" FontSize="11"/>
                                            <Button Content="حذف" 
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding Id}"
                                                    Style="{StaticResource ButtonStyle.Danger}" 
                                                    Height="28" Padding="10,2" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Categories Card View -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsCardsView, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListBox ItemsSource="{Binding FilteredCategories}" SelectedItem="{Binding SelectedCategory}"
                             Background="Transparent" BorderThickness="0" Margin="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" Margin="0"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="200" Margin="8" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2" Direction="270"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="100"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Category Icon Circle Header -->
                                        <Border Grid.Row="0" CornerRadius="12,12,0,0" Background="#1038e07b">
                                            <Border Width="50" Height="50" CornerRadius="25" Background="{StaticResource BrushSurface}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconCategories}" Fill="{StaticResource BrushPrimary}" Stretch="Uniform" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Border>

                                        <!-- Category Name and ID -->
                                        <Border Grid.Row="1" Padding="12,14,12,10">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource BrushTextPrimary}" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Id, StringFormat={}معرف: #{0}}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Action Buttons -->
                                        <Grid Grid.Row="2" Margin="12,0,12,12" Visibility="{Binding DataContext.CanManageCategories, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <Button Grid.Column="0" Content="تعديل" 
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource ButtonStyle.Secondary}" 
                                                    Height="30" FontSize="11" Padding="0"/>
                                            
                                            <Button Grid.Column="2" Content="حذف" 
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                    CommandParameter="{Binding Id}"
                                                    Style="{StaticResource ButtonStyle.Danger}" 
                                                    Height="30" FontSize="11" Padding="0"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Sidebar Panel for Add/Edit -->
        <Border Grid.Column="1" 
                Width="320" 
                Background="{StaticResource BrushSurface}" 
                BorderBrush="{StaticResource BrushBorder}" 
                BorderThickness="1,0,0,0"
                Visibility="{Binding IsFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Text="بيانات التصنيف" Style="{StaticResource TextStyle.H3}"/>
                    <Button Command="{Binding CancelFormCommand}" Style="{StaticResource ButtonStyle.Secondary}" Width="30" Height="30" Padding="0" HorizontalAlignment="Right">
                        <Path Data="{StaticResource IconClose}" Fill="{StaticResource BrushTextPrimary}" Stretch="Uniform" Width="10" Height="10"/>
                    </Button>
                </Grid>

                <!-- Form Inputs -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="اسم التصنيف" Style="{StaticResource TextStyle.Label}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" Height="40" Margin="0,0,0,20"/>

                    <TextBlock Text="محطة الطباعة المرتبطة" Style="{StaticResource TextStyle.Label}" Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding PrintStations}"
                              SelectedValue="{Binding SelectedPrintStationId}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Name"
                              Height="40"
                              Margin="0,0,0,20"/>

                    <!-- Form Error Display -->
                    <Border Background="#10ef4444" CornerRadius="8" Padding="12,10" Margin="0,0,0,20" 
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource TextStyle.Muted}" Foreground="{StaticResource BrushDanger}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Row="2">
                    <Button Content="حفظ التصنيف" 
                            Command="{Binding SaveCommand}" 
                            Style="{StaticResource ButtonStyle.Primary}" 
                            Height="42" Margin="0,0,0,10"/>
                    <Button Content="إلغاء" 
                            Command="{Binding CancelFormCommand}" 
                            Style="{StaticResource ButtonStyle.Secondary}" 
                            Height="40"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Background="#50ffffff" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ctrls:LoadingSpinner/>
        </Grid>
    </Grid>
</UserControl>
