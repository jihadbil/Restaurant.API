<UserControl x:Class="Restaurant.Desktop.Views.Pages.OrdersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Restaurant.Desktop.Views.Pages"
             xmlns:ctrls="clr-namespace:Restaurant.Desktop.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             FlowDirection="RightToLeft">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Orders List Grid Area -->
            <ColumnDefinition Width="*"/>
            <!-- Order Details Panel -->
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Orders Table column -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="إدارة الطلبات" Style="{StaticResource TextStyle.H1}"/>
                    <TextBlock Text="متابعة حالة تحضير وتسليم الطلبات الحالية" Style="{StaticResource TextStyle.Muted}"/>
                </StackPanel>
            </Grid>

            <!-- Status filter selector tabs and controls -->
            <Border Grid.Row="1" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Right: Status radio buttons -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <RadioButton Content="الكل" IsChecked="True" Style="{StaticResource SegmentedRadioButtonStyle}" Command="{Binding LoadOrdersCommand}" CommandParameter="All"/>
                        <RadioButton x:Name="RadioPrep" Content="قيد التحضير" Style="{StaticResource SegmentedRadioButtonStyle}" Checked="RadioStatus_Checked"/>
                        <RadioButton x:Name="RadioReady" Content="جاهز للتسليم" Style="{StaticResource SegmentedRadioButtonStyle}" Checked="RadioStatus_Checked"/>
                        <RadioButton x:Name="RadioDelivered" Content="تم التسليم" Style="{StaticResource SegmentedRadioButtonStyle}" Checked="RadioStatus_Checked"/>
                        <RadioButton x:Name="RadioCancelled" Content="ملغى" Style="{StaticResource SegmentedRadioButtonStyle}" Checked="RadioStatus_Checked"/>
                    </StackPanel>

                    <!-- Left: Date Filter & View mode switcher -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                        <!-- Date Filter CheckBox -->
                        <CheckBox Content="فلترة بالتاريخ" IsChecked="{Binding FilterByDate}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <!-- Date range Pickers -->
                        <TextBlock Text="من:" VerticalAlignment="Center" FontSize="12" Margin="0,0,5,0" IsEnabled="{Binding FilterByDate}"/>
                        <DatePicker SelectedDate="{Binding SelectedDateFrom}" IsEnabled="{Binding FilterByDate}" Width="110" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="إلى:" VerticalAlignment="Center" FontSize="12" Margin="0,0,5,0" IsEnabled="{Binding FilterByDate}"/>
                        <DatePicker SelectedDate="{Binding SelectedDateTo}" IsEnabled="{Binding FilterByDate}" Width="110" VerticalAlignment="Center" Margin="0,0,20,0"/>

                        <!-- View mode selector (Table vs Cards) -->
                        <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="2" Background="{StaticResource BrushBackground}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RadioTable" Content="جدول" Style="{StaticResource SegmentedRadioButtonStyle}" IsChecked="True" Checked="RadioViewMode_Checked" Padding="8,4" FontSize="11"/>
                                <RadioButton x:Name="RadioCards" Content="بطاقات" Style="{StaticResource SegmentedRadioButtonStyle}" Checked="RadioViewMode_Checked" Padding="8,4" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Orders Table / Cards Container -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0">
                <Grid>
                    <!-- 1. Table View (DataGrid) -->
                    <DataGrid ItemsSource="{Binding FilteredOrders}" SelectedItem="{Binding SelectedOrder}">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.ViewMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Table">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DataContext.IsOrdersListEmpty, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم الطلب" Binding="{Binding OrderNumber}" Width="100"/>
                            <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding Date, StringFormat={}{0:yyyy/MM/dd HH:mm}}" Width="150"/>
                            <DataGridTextColumn Header="المجموع" Binding="{Binding Total, StringFormat={}{0:N2} د.ل}" Width="100"/>
                            <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding Name}" Width="120"/>
                            <DataGridTemplateColumn Header="الحالة" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ctrls:StatusBadge Status="{Binding OrderStatus}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="الإجراءات" Width="185">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Removed LoadOrdersCommand execution from Button to fix disappearing details panel -->
                                            <Button Content="تفاصيل الطلب" 
                                                    Click="BtnDetails_Click"
                                                    Style="{StaticResource ButtonStyle.Secondary}" 
                                                    Height="28" Padding="10,2" Margin="0,0,8,0" FontSize="11"/>
                                            <Button Content="حذف" 
                                                    Command="{Binding DataContext.DeleteOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding Id}"
                                                    Style="{StaticResource ButtonStyle.Danger}" 
                                                    Height="28" Padding="10,2" FontSize="11"
                                                    Visibility="{Binding DataContext.CanVoidOrder, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 2. Cards View -->
                    <ListBox ItemsSource="{Binding FilteredOrders}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.ViewMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Cards">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DataContext.IsOrdersListEmpty, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Background="{StaticResource BrushSurface}" Margin="8" Width="210" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header: Order Number and Status -->
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding OrderNumber, StringFormat={}طلب #{0}}" Style="{StaticResource TextStyle.Label}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                            <ctrls:StatusBadge Status="{Binding OrderStatus}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- DateTime -->
                                        <TextBlock Grid.Row="1" Text="{Binding Date, StringFormat={}{0:yyyy/MM/dd HH:mm}}" Style="{StaticResource TextStyle.Muted}" FontSize="11" Margin="0,0,0,8"/>

                                        <!-- Payment & Total -->
                                        <StackPanel Grid.Row="2" Margin="0,0,0,12">
                                            <Grid>
                                                <TextBlock Text="طريقة الدفع:" Style="{StaticResource TextStyle.Muted}" FontSize="11"/>
                                                <TextBlock Text="{Binding PaymentMethodName}" Style="{StaticResource TextStyle.Body}" FontSize="11" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,4,0,0">
                                                <TextBlock Text="المجموع:" Style="{StaticResource TextStyle.Label}" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Total, StringFormat={}{0:N2} د.ل}" Style="{StaticResource TextStyle.Label}" Foreground="{StaticResource BrushPrimary}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Actions -->
                                        <Grid Grid.Row="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="التفاصيل" Click="BtnDetails_Click" Style="{StaticResource ButtonStyle.Secondary}" Height="28" Padding="6,2" FontSize="11" Margin="0,0,4,0"/>
                                            <Button Grid.Column="1" Content="حذف" Command="{Binding DataContext.DeleteOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" Style="{StaticResource ButtonStyle.Danger}" Height="28" Padding="10,2" FontSize="11"
                                                    Visibility="{Binding DataContext.CanVoidOrder, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 3. Empty State -->
                    <ctrls:EmptyState Title="لا توجد فواتير أو طلبات" 
                                      Subtitle="لم يتم العثور على أي فواتير مسجلة في النظام حالياً أو تطابق شروط الفلترة المحددة."
                                      Icon="{StaticResource IconNote}">
                        <ctrls:EmptyState.Style>
                            <Style TargetType="UserControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOrdersListEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ctrls:EmptyState.Style>
                    </ctrls:EmptyState>
                </Grid>
            </Border>
        </Grid>

        <!-- Right Side Panel for Order Details -->
        <Border Grid.Column="1" 
                Width="380" 
                Background="{StaticResource BrushSurface}" 
                BorderBrush="{StaticResource BrushBorder}" 
                BorderThickness="1,0,0,0"
                Visibility="{Binding IsDetailsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header Details -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedOrder.OrderNumber, StringFormat={}تفاصيل الطلب #{0}}" Style="{StaticResource TextStyle.H3}"/>
                        <TextBlock Text="{Binding SelectedOrder.Date, StringFormat={}{0:yyyy/MM/dd HH:mm}}" Style="{StaticResource TextStyle.Muted}"/>
                    </StackPanel>
                    <Button Command="{Binding CloseDetailsCommand}" Style="{StaticResource ButtonStyle.Secondary}" Width="30" Height="30" Padding="0" HorizontalAlignment="Right">
                        <Path Data="{StaticResource IconClose}" Fill="{StaticResource BrushTextPrimary}" Stretch="Uniform" Width="10" Height="10"/>
                    </Button>
                </Grid>

                <!-- Status Modification Quick Actions -->
                <Border Grid.Row="1" Background="{StaticResource BrushBackground}" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="تحديث الحالة سريعا:" Style="{StaticResource TextStyle.Label}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Status buttons handled via code-behind Click events using Tag -->
                            <Button Grid.Column="0" Content="تحضير" 
                                    Style="{StaticResource ButtonStyle.Secondary}" Height="40" Margin="0,0,4,0" FontSize="11" Click="BtnChangeStatus_Click" Tag="Preparing"/>
                            
                            <Button Grid.Column="1" Content="جاهز" 
                                    Style="{StaticResource ButtonStyle.Secondary}" Height="40" Margin="2,0,2,0" FontSize="11" Click="BtnChangeStatus_Click" Tag="Ready"/>
                            
                            <Button Grid.Column="2" Content="تسليم" 
                                    Style="{StaticResource ButtonStyle.Primary}" Height="40" Margin="4,0,0,0" FontSize="11" Click="BtnChangeStatus_Click" Tag="Delivered"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Order items list -->
                <Grid Grid.Row="2" Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="العناصر المطلوبة" Style="{StaticResource TextStyle.Label}" Margin="0,0,0,8"/>
                    
                    <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedOrder.OrderItems}" AutoGenerateColumns="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="2*"/>
                            <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="70"/>
                            <DataGridTextColumn Header="السعر" Binding="{Binding UnitSalePrice, StringFormat={}{0:N2} د.ل}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Order Totals summary -->
                <Border Grid.Row="3" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                    <StackPanel>
                        <!-- Discount -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="الخصم الممنوح:" Style="{StaticResource TextStyle.Muted}"/>
                            <TextBlock Text="{Binding SelectedOrder.Discount, StringFormat={}{0:N2} د.ل}" Style="{StaticResource TextStyle.Body}" HorizontalAlignment="Right"/>
                        </Grid>
                        
                        <!-- Notes -->
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="ملاحظات:" Style="{StaticResource TextStyle.Muted}"/>
                            <TextBlock Text="{Binding SelectedOrder.Notes}" Style="{StaticResource TextStyle.Body}" HorizontalAlignment="Right" TextWrapping="Wrap" MaxWidth="220"/>
                        </Grid>

                        <!-- Total -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="الإجمالي النهائي:" Style="{StaticResource TextStyle.Label}" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectedOrder.Total, StringFormat={}{0:N2} د.ل}" Style="{StaticResource TextStyle.H2}" Foreground="{StaticResource BrushPrimary}" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Background="#50ffffff" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ctrls:LoadingSpinner/>
        </Grid>
    </Grid>
</UserControl>
