<Window x:Class="Restaurant.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Restaurant.Desktop.Views"
        mc:Ignorable="d"
        Title="تسجيل الدخول - Emerald Management Pro" 
        Height="550" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBackground}"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FocusManager.FocusedElement="{Binding ElementName=TxtUserName}">
    
    <Window.Resources>
        <Storyboard x:Key="ShakeAnimation">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LoginFormGrid" Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.X)">
                <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.05" Value="-15"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="15"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="-15"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="15"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="-10"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="10"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="-5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.45" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Column 0: Side Panel (Right side in RTL) -->
            <ColumnDefinition Width="350" />
            <!-- Column 1: Login Form (Left side in RTL) -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Column 0: Side Panel (Right side in RTL) -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#38e07b" Offset="0"/>
                    <GradientStop Color="#122017" Offset="1.2"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Logo and Title Stack -->
                <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Brand Logo -->
                    <Border Width="90" Height="90" CornerRadius="45" Background="White" Margin="0,0,0,20" HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconProducts}" Fill="#38e07b" Stretch="Uniform" Width="40" Height="40" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <!-- Brand Name -->
                    <TextBlock Text="Emerald Management Pro" Style="{StaticResource TextStyle.H2}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8" FontSize="20"/>
                    <!-- Description -->
                    <TextBlock Text="نظام إدارة المطاعم والمقاهي المتكامل" Style="{StaticResource TextStyle.Muted}" Foreground="White" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="13"/>
                </StackPanel>
                
                <!-- Bottom Info -->
                <TextBlock Grid.Row="1" Text="النسخة 2.0" Style="{StaticResource TextStyle.Muted}" Foreground="White" HorizontalAlignment="Center" FontSize="11"/>
            </Grid>
        </Border>

        <!-- Column 1: Login Form (Left side in RTL) -->
        <Grid x:Name="LoginFormGrid" Grid.Column="1" Margin="40,20" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TranslateTransform X="0" Y="0"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" VerticalAlignment="Center">
                <!-- Title -->
                <TextBlock Text="تسجيل الدخول" Style="{StaticResource TextStyle.H2}" Margin="0,0,0,8" FontWeight="Bold"/>
                <TextBlock Text="يرجى إدخال بيانات الاعتماد للوصول إلى النظام" Style="{StaticResource TextStyle.Muted}" Margin="0,0,0,24"/>

                <!-- Username field -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="اسم المستخدم أو البريد الإلكتروني" Style="{StaticResource TextStyle.Label}" Margin="0,0,0,6"/>
                    <Grid>
                        <TextBox x:Name="TxtUserName" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Height="40" VerticalContentAlignment="Center" Padding="8,0"/>
                        <TextBlock Text="أدخل اسم المستخدم..." Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextStyle.Muted}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtUserName}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>

                <!-- Password field -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="كلمة المرور" Style="{StaticResource TextStyle.Label}" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Masked Password Input -->
                        <Grid Grid.Column="0">
                            <PasswordBox x:Name="TxtPassword" Height="40" VerticalContentAlignment="Center" Padding="8,0"/>
                            <!-- Watermark for Password -->
                            <TextBlock x:Name="TxtPasswordWatermark" Text="أدخل كلمة المرور..." Style="{StaticResource TextStyle.Muted}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                        <!-- Plain Text Password Input (Revealed) -->
                        <TextBox x:Name="TxtPasswordReveal" Grid.Column="0" Height="40" VerticalContentAlignment="Center" Padding="8,0" Visibility="Collapsed"/>
                        <!-- Show/Hide Button -->
                        <Button x:Name="BtnTogglePassword" Grid.Column="1" Click="TogglePasswordVisibility_Click" Margin="6,0,0,0" Width="44" Height="40" Style="{StaticResource ButtonStyle.Secondary}" ToolTip="إظهار/إخفاء كلمة المرور" Cursor="Hand" Focusable="False">
                            <Path x:Name="PasswordToggleIcon" Data="{StaticResource IconEye}" Fill="{StaticResource BrushTextMuted}" Stretch="Uniform" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Error Message -->
                <Border x:Name="ErrorBorder" Background="{StaticResource BrushDangerBg}" BorderBrush="{StaticResource BrushDangerHover}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,20" 
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource IconWarning}" Fill="{StaticResource BrushDanger}" Stretch="Uniform" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Style="{StaticResource TextStyle.Muted}" Foreground="{StaticResource BrushDanger}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Action Panel -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Login Button -->
                    <Button Grid.Column="0" Content="تسجيل الدخول" 
                            Command="{Binding LoginCommand}" 
                            CommandParameter="{Binding ElementName=TxtPassword}"
                            Style="{StaticResource ButtonStyle.Primary}" 
                            Height="44" 
                            Margin="0,0,8,0"
                            IsDefault="True"/>
                    
                    <!-- On-Screen Keyboard Button -->
                    <Button Grid.Column="1" Click="ShowKeyboard_Click"
                            Style="{StaticResource ButtonStyle.Secondary}"
                            Width="44" Height="44" Padding="0" ToolTip="لوحة المفاتيح على الشاشة" Cursor="Hand">
                        <Path Data="M20 5H4c-1.1 0-1.99.9-1.99 2L2 17c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm-9 3h2v2h-2V8zm0 3h2v2h-2v-2zM8 8h2v2H8V8zm0 3h2v2H8v-2zm-3 0h2v2H5v-2zm0-3h2v2H5V8zm3 6h8v2H8v-2zm8-3h2v2h-2v-2zm0-3h2v2h-2V8zm3 3h2v2h-2v-2zm0-3h2v2h-2V8z" 
                              Fill="{StaticResource BrushTextPrimary}" 
                              Stretch="Uniform" 
                              Width="22" Height="22" 
                              VerticalAlignment="Center" 
                              HorizontalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- Loading Indicator Overlay if busy -->
                <Grid Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" Height="30" Margin="0,15,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="جاري تسجيل الدخول والاتصال بالخادم..." Style="{StaticResource TextStyle.Muted}" Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Keyboard Panel -->
            <Border Grid.Row="1" x:Name="KeyboardPanel" Visibility="Collapsed" Background="{StaticResource BrushNeutral100}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,12,0,0">
                <StackPanel>
                    <StackPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource ButtonStyle.Secondary}">
                            <Setter Property="Width" Value="32"/>
                            <Setter Property="Height" Value="34"/>
                            <Setter Property="Margin" Value="2"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
                            <EventSetter Event="Click" Handler="Key_Click"/>
                        </Style>
                    </StackPanel.Resources>
                    
                    <!-- Row 1: Numbers -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="1"/>
                        <Button Content="2"/>
                        <Button Content="3"/>
                        <Button Content="4"/>
                        <Button Content="5"/>
                        <Button Content="6"/>
                        <Button Content="7"/>
                        <Button Content="8"/>
                        <Button Content="9"/>
                        <Button Content="0"/>
                        <Button Content="⌫" x:Name="BtnBackspace" Click="Backspace_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ButtonStyle.Secondary}">
                                    <Setter Property="Width" Value="45"/>
                                    <Setter Property="Height" Value="34"/>
                                    <Setter Property="Margin" Value="2"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    
                    <!-- Row 2: QWERTY -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="q"/>
                        <Button Content="w"/>
                        <Button Content="e"/>
                        <Button Content="r"/>
                        <Button Content="t"/>
                        <Button Content="y"/>
                        <Button Content="u"/>
                        <Button Content="i"/>
                        <Button Content="o"/>
                        <Button Content="p"/>
                    </StackPanel>
                    
                    <!-- Row 3: ASDF -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="a"/>
                        <Button Content="s"/>
                        <Button Content="d"/>
                        <Button Content="f"/>
                        <Button Content="g"/>
                        <Button Content="h"/>
                        <Button Content="j"/>
                        <Button Content="k"/>
                        <Button Content="l"/>
                    </StackPanel>
                    
                    <!-- Row 4: ZXCV -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="⇧" x:Name="BtnShift" Click="Shift_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ButtonStyle.Secondary}">
                                    <Setter Property="Width" Value="45"/>
                                    <Setter Property="Height" Value="34"/>
                                    <Setter Property="Margin" Value="2"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="z"/>
                        <Button Content="x"/>
                        <Button Content="c"/>
                        <Button Content="v"/>
                        <Button Content="b"/>
                        <Button Content="n"/>
                        <Button Content="m"/>
                        <Button Content="Clear" Click="Clear_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ButtonStyle.Secondary}">
                                    <Setter Property="Width" Value="45"/>
                                    <Setter Property="Height" Value="34"/>
                                    <Setter Property="Margin" Value="2"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    
                    <!-- Row 5: Special & Space -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="@">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ButtonStyle.Secondary}">
                                    <Setter Property="Width" Value="36"/>
                                    <Setter Property="Height" Value="34"/>
                                    <Setter Property="Margin" Value="2"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content=".">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ButtonStyle.Secondary}">
                                    <Setter Property="Width" Value="32"/>
                                    <Setter Property="Height" Value="34"/>
                                    <Setter Property="Margin" Value="2"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="_">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ButtonStyle.Secondary}">
                                    <Setter Property="Width" Value="32"/>
                                    <Setter Property="Height" Value="34"/>
                                    <Setter Property="Margin" Value="2"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Space" Click="Space_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ButtonStyle.Secondary}">
                                    <Setter Property="Width" Value="180"/>
                                    <Setter Property="Height" Value="34"/>
                                    <Setter Property="Margin" Value="2"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Hide" Click="HideKeyboard_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ButtonStyle.Secondary}">
                                    <Setter Property="Width" Value="50"/>
                                    <Setter Property="Height" Value="34"/>
                                    <Setter Property="Margin" Value="2"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
