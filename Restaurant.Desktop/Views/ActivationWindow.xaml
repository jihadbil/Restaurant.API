<Window x:Class="Restaurant.Desktop.Views.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Restaurant.Desktop.Views"
        mc:Ignorable="d"
        Title="تفعيل النظام" Height="480" Width="620"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource CairoFont}">
    
    <Window.Resources>
        <!-- Style for the text boxes -->
        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="{StaticResource BrushBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" Color="#000000" Opacity="0.3" ShadowDepth="4" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Frameless TitleBar -->
            <Border Grid.Row="0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" MouseDown="TitleBar_MouseDown" CornerRadius="11,11,0,0">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="10" Background="#1538e07b" Margin="0,0,8,0">
                            <Path Data="{StaticResource IconProducts}" Fill="{StaticResource BrushPrimary}" Stretch="Uniform" Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Emerald Management Pro - تفعيل الترخيص" Style="{StaticResource TextStyle.Label}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Grid.Column="1" Background="Transparent"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowControlButtonStyle}" Click="BtnMinimize_Click" ToolTip="تصغير">
                            <Path Data="M19 13H5v-2h14v2z" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Stretch="Uniform" Width="10" Height="10"/>
                        </Button>
                        <Button Style="{StaticResource WindowCloseButtonStyle}" Click="BtnClose_Click" ToolTip="إغلاق">
                            <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Stretch="Uniform" Width="10" Height="10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Row="1" Margin="32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24" HorizontalAlignment="Center">
                    <TextBlock Text="تفعيل ترخيص النظام" Style="{StaticResource TextStyle.H2}" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="يرجى إدخال مفتاح الترخيص الخاص بك لتفعيل البرنامج" Style="{StaticResource TextStyle.Muted}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Machine Info Card -->
                <Border Grid.Row="1" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="معرف الجهاز (للدعم الفني):" Style="{StaticResource TextStyle.Label}" Foreground="{StaticResource BrushPrimary}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding MachineFingerprint, Mode=OneWay}" 
                                 IsReadOnly="True" 
                                 BorderThickness="0" 
                                 Background="Transparent" 
                                 Foreground="{StaticResource BrushTextPrimary}"
                                 FontFamily="Consolas"
                                 FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Input Area -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="مفتاح الترخيص:" Style="{StaticResource TextStyle.Label}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource InputTextBox}"
                             Margin="0,0,0,20" />

                    <!-- Activation Button -->
                    <Button Content="تفعيل الآن" 
                            Command="{Binding ActivateCommand}"
                            Style="{StaticResource ButtonStyle.Primary}"
                            Height="44"/>
                </StackPanel>

                <!-- Status Message Area -->
                <StackPanel Grid.Row="3" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <TextBlock Text="{Binding StatusMessage}" 
                               FontSize="13" 
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
