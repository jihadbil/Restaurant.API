<Window x:Class="Restaurant.Desktop.Views.ExcludeAddonsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="تحديد الإضافات المستبعدة" 
        Height="450" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BrushBackground}"
        FlowDirection="RightToLeft">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="تخصيص الصنف" Style="{StaticResource TextStyle.H2}" FontWeight="Bold"/>
            <TextBlock Text="حدد الإضافات التي لا يريدها الزبون في الوجبة:" Style="{StaticResource TextStyle.Muted}" Margin="0,4,0,0"/>
        </StackPanel>

        <Separator Grid.Row="1" Background="{StaticResource BrushBorder}" Margin="0,0,0,16"/>

        <!-- Addons List with Checkboxes -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding AddonOptions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="8,10">
                            <CheckBox IsChecked="{Binding IsExcluded, Mode=TwoWay}" 
                                      Content="{Binding Name}" 
                                      FontFamily="{StaticResource CairoFont}"
                                      FontSize="14"
                                      VerticalContentAlignment="Center"
                                      Cursor="Hand"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="حفظ التعديلات" 
                    Click="SaveButton_Click"
                    Style="{StaticResource ButtonStyle.Primary}" 
                    Width="120" Height="36" Margin="0,0,10,0"/>
            <Button Content="إلغاء" 
                    Click="CancelButton_Click"
                    Style="{StaticResource ButtonStyle.Secondary}" 
                    Width="80" Height="36"/>
        </StackPanel>
    </Grid>
</Window>
