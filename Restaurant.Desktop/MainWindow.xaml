<Window x:Class="Restaurant.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Restaurant.Desktop"
        xmlns:vm="clr-namespace:Restaurant.Desktop.ViewModels"
        xmlns:pages="clr-namespace:Restaurant.Desktop.Views.Pages"
        xmlns:ctrls="clr-namespace:Restaurant.Desktop.Controls"
        mc:Ignorable="d"
        Title="Emerald Management Pro - لوحة التحكم" 
        Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBackground}"
        FlowDirection="RightToLeft">

    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding NavigateToNewOrderCommand}"/>
        <KeyBinding Key="F2" Command="{Binding NavigateToOrdersCommand}"/>
        <KeyBinding Key="F3" Command="{Binding NavigateToProductsCommand}"/>
        <KeyBinding Key="F4" Command="{Binding NavigateToTreasuryCommand}"/>
        <KeyBinding Key="F5" Command="{Binding NavigateToReportsCommand}"/>
        <KeyBinding Key="F12" Command="{Binding OpenShiftCloseCommand}"/>
    </Window.InputBindings>

    <!-- Add DataTemplates to automatically map ViewModels to Views -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <pages:DashboardPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OrdersViewModel}">
            <pages:OrdersPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NewOrderViewModel}">
            <pages:NewOrderPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <pages:ProductsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CategoriesViewModel}">
            <pages:CategoriesPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <pages:ReportsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <pages:SettingsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TreasuryViewModel}">
            <pages:TreasuryPage />
        </DataTemplate>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Column 0: Sidebar (Right side in RTL) -->
            <ColumnDefinition Width="Auto"/>
            <!-- Column 1: Content Area (Left side in RTL) -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Panel -->
        <Border Grid.Column="0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="240"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarVisible}" Value="False">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="72" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="240" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Margin="16,24">
                <Grid.RowDefinitions>
                    <!-- Brand Section -->
                    <RowDefinition Height="Auto"/>
                    <!-- Menu Navigation -->
                    <RowDefinition Height="*"/>
                    <!-- Footer Section -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Section / Top Sidebar Header -->
                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Row 0: Logo and Title -->
                    <Grid Grid.Row="0" x:Name="BrandHeaderGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Logo -->
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#1538e07b" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding RestaurantLogoUrl, Converter={StaticResource ImageUrlConverter}}" 
                                       Stretch="UniformToFill"
                                       Visibility="{Binding RestaurantLogoUrl, Converter={StaticResource StringToVisibilityConverter}}"/>
                                <Path Data="M2 21h18v-2H2v2zM20 8h-2V5h2v3zm2-5H18c-1.1 0-2 .9-2 2v3c0 1.1.9 2 2 2h2c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM4 19h12v-9H4v9zM4 5v3h12V5H4z" 
                                      Fill="{StaticResource BrushPrimary}" 
                                      Stretch="Uniform" 
                                      Width="18" Height="18" 
                                      VerticalAlignment="Center" 
                                      HorizontalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RestaurantLogoUrl}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RestaurantLogoUrl}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                        </Border>
                        
                        <!-- Title (hidden when collapsed) -->
                        <TextBlock Grid.Column="1" Text="{Binding RestaurantName, FallbackValue='مقهى Emerald'}" 
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" 
                                   Margin="8,0,0,0"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextStyle.H3}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSidebarVisible}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Row 1: Toggle Button -->
                    <Button Grid.Row="1" Command="{Binding ToggleSidebarCommand}"
                            Height="36" Padding="0" Margin="0,12,0,0" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ButtonStyle.Secondary}">
                                <Setter Property="Width" Value="200"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarVisible}" Value="False">
                                        <Setter Property="Width" Value="40"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="{StaticResource IconMenu}" Fill="{StaticResource BrushTextPrimary}" Stretch="Uniform" Width="18" Height="18"/>
                    </Button>
                </Grid>

                <!-- Menu Navigation List -->
                <StackPanel Grid.Row="1">
                    
                    <!-- Dashboard Menu Item -->
                    <RadioButton Content="لوحة القيادة" 
                                 Command="{Binding NavigateToDashboardCommand}"
                                 IsChecked="{Binding SelectedMenuItem, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Dashboard, Mode=TwoWay}"
                                 Style="{StaticResource SidebarRadioButtonStyle}" 
                                 Tag="{StaticResource IconDashboard}"
                                 Visibility="{Binding CanAccessDashboard, Converter={StaticResource BoolToVis}}"/>

                    <!-- New Order Item -->
                    <RadioButton Content="طلب جديد (POS)" 
                                 Command="{Binding NavigateToNewOrderCommand}"
                                 IsChecked="{Binding SelectedMenuItem, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=NewOrder, Mode=TwoWay}"
                                 Style="{StaticResource SidebarRadioButtonStyle}" 
                                 Tag="{StaticResource IconNewOrder}"
                                 Visibility="{Binding CanAccessNewOrder, Converter={StaticResource BoolToVis}}"/>

                    <!-- Orders Item -->
                    <RadioButton Content="قائمة الطلبات" 
                                 Command="{Binding NavigateToOrdersCommand}"
                                 IsChecked="{Binding SelectedMenuItem, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Orders, Mode=TwoWay}"
                                 Style="{StaticResource SidebarRadioButtonStyle}" 
                                 Tag="{StaticResource IconOrders}"
                                 Visibility="{Binding CanAccessOrders, Converter={StaticResource BoolToVis}}"/>

                    <!-- Products Item -->
                    <RadioButton Content="المنتجات والأصناف" 
                                 Command="{Binding NavigateToProductsCommand}"
                                 IsChecked="{Binding SelectedMenuItem, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Products, Mode=TwoWay}"
                                 Style="{StaticResource SidebarRadioButtonStyle}" 
                                 Tag="{StaticResource IconProducts}"
                                 Visibility="{Binding CanAccessProducts, Converter={StaticResource BoolToVis}}"/>

                    <!-- Categories Item -->
                    <RadioButton Content="التصنيفات" 
                                 Command="{Binding NavigateToCategoriesCommand}"
                                 IsChecked="{Binding SelectedMenuItem, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Categories, Mode=TwoWay}"
                                 Style="{StaticResource SidebarRadioButtonStyle}" 
                                 Tag="{StaticResource IconCategories}"
                                 Visibility="{Binding CanAccessCategories, Converter={StaticResource BoolToVis}}"/>

                    <!-- Reports Item -->
                    <RadioButton Content="التقارير والإحصائيات" 
                                 Command="{Binding NavigateToReportsCommand}"
                                 IsChecked="{Binding SelectedMenuItem, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Reports, Mode=TwoWay}"
                                 Style="{StaticResource SidebarRadioButtonStyle}" 
                                 Tag="{StaticResource IconReports}"
                                 Visibility="{Binding CanAccessReports, Converter={StaticResource BoolToVis}}"/>

                    <!-- Settings Item -->
                    <RadioButton Content="إعدادات النظام" 
                                 Command="{Binding NavigateToSettingsCommand}"
                                 IsChecked="{Binding SelectedMenuItem, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Settings, Mode=TwoWay}"
                                 Style="{StaticResource SidebarRadioButtonStyle}" 
                                 Tag="{StaticResource IconSettings}"
                                 Visibility="{Binding CanAccessSettings, Converter={StaticResource BoolToVis}}"/>

                    <!-- Treasury Item -->
                    <RadioButton Content="حركات الخزينة" 
                                 Command="{Binding NavigateToTreasuryCommand}"
                                 IsChecked="{Binding SelectedMenuItem, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Treasury, Mode=TwoWay}"
                                 Style="{StaticResource SidebarRadioButtonStyle}" 
                                 Tag="{StaticResource IconTreasury}"
                                 Visibility="{Binding CanAccessTreasury, Converter={StaticResource BoolToVis}}"/>

                </StackPanel>

                <!-- Powered By Footer -->
                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <Separator Background="{StaticResource BrushBorder}" Margin="0,0,0,12"/>
                    <TextBlock FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextStyle.Muted}">
                                <Setter Property="Text" Value="Powered by Emerald Management Pro"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarVisible}" Value="False">
                                        <Setter Property="Text" Value="E.M.P"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header with User Profile -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <!-- Current Page Title & Hamburger Toggle -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleSidebarCommand}" 
                            Style="{StaticResource ButtonStyle.Secondary}" 
                            Padding="8" BorderThickness="0" 
                            Width="36" Height="36" Margin="0,0,12,0" 
                            Focusable="False">
                        <Path Data="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" 
                              Fill="{StaticResource BrushTextPrimary}" 
                              Stretch="Uniform" Width="16" Height="16"/>
                    </Button>
                    <TextBlock Text="{Binding CurrentPageTitle}" Style="{StaticResource TextStyle.H2}" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- User Profile Button aligned to the far physical left (Right in RTL flow) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="UserMenuButton" Click="UserMenuButton_Click" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Focusable="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" Padding="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Circle Avatar -->
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                            <Path Data="{StaticResource IconUser}" Fill="{StaticResource BrushTextMuted}" Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                        <!-- User Name and arrow -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" Orientation="Horizontal">
                                            <TextBlock Text="{Binding CurrentUserName}" Style="{StaticResource TextStyle.Label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Path Data="{StaticResource IconArrowDown}" Fill="{StaticResource BrushTextMuted}" Stretch="Uniform" Width="10" Height="10" Margin="6,2,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- User Options Popup -->
                    <Popup x:Name="UserPopup" PlacementTarget="{Binding ElementName=UserMenuButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Width="180" Margin="0,4,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Color="#000" Opacity="0.1" ShadowDepth="2"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="{Binding CurrentUserName}" FontWeight="Bold" Style="{StaticResource TextStyle.Label}" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                                <TextBlock Text="{Binding CurrentUserRoleDisplay}" Style="{StaticResource TextStyle.Muted}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <Separator Background="{StaticResource BrushBorder}" Margin="0,0,0,8"/>
                                
                                <Button Content="إغلاق الوردية" 
                                        Command="{Binding OpenShiftCloseCommand}"
                                        Style="{StaticResource ButtonStyle.Danger}"
                                        Height="40" Margin="0,0,0,6" Click="UserMenuItem_Click"/>
                                        
                                <Button Content="تسجيل الخروج" 
                                        Command="{Binding LogoutCommand}"
                                        Style="{StaticResource ButtonStyle.Secondary}"
                                        Height="40" Click="UserMenuItem_Click"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>

            <!-- Content Area -->
            <ctrls:AnimatedContentControl Grid.Row="1" Content="{Binding CurrentPage}"/>

            <!-- Toast Notification Container -->
            <ctrls:ToastNotification x:Name="NotificationToast" 
                                     Grid.Row="0" Grid.RowSpan="2" 
                                     VerticalAlignment="Bottom" 
                                     HorizontalAlignment="Left" 
                                     Margin="16,0,0,16"/>
        </Grid>
    </Grid>
</Window>
