<UserControl x:Class="Restaurant.Desktop.Controls.Printing.KitchenTicketPrintControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignWidth="302"
             Background="White"
             Foreground="Black"
             FontFamily="Arial"
             FontSize="12"
             FlowDirection="RightToLeft">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="10,5,10,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Station Header -->
            <RowDefinition Height="Auto"/> <!-- Divider -->
            <RowDefinition Height="Auto"/> <!-- Huge Order Number & Type -->
            <RowDefinition Height="Auto"/> <!-- Time & Type Info -->
            <RowDefinition Height="Auto"/> <!-- Divider -->
            <RowDefinition Height="Auto"/> <!-- Items List -->
            <RowDefinition Height="Auto"/> <!-- Divider -->
            <RowDefinition Height="Auto"/> <!-- Order Notes -->
            <RowDefinition Height="Auto"/> <!-- Bottom spacing -->
        </Grid.RowDefinitions>

        <!-- 1. Print Station Header -->
        <TextBlock Grid.Row="0" 
                   Text="{Binding StationName, StringFormat={}تذكرة تحضير - {0}}" 
                   FontWeight="Bold" 
                   FontSize="16" 
                   HorizontalAlignment="Center" 
                   TextAlignment="Center" 
                   Margin="0,0,0,5"/>

        <!-- 2. Divider -->
        <Border Grid.Row="1" BorderBrush="Black" BorderThickness="0,2,0,0" Height="3" Margin="0,2,0,5"/>

        <!-- 3. Huge Order Number & Order Type Indicator -->
        <Border Grid.Row="2" 
                Background="{Binding OrderTypeBgBrush}" 
                BorderBrush="Black" 
                BorderThickness="2" 
                CornerRadius="8" 
                Padding="8" 
                Margin="0,5,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="طلب رقم:" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text="{Binding OrderNumber}" FontSize="42" FontWeight="Bold" LineHeight="45" Margin="0,-5,0,0"/>
                </StackPanel>
                
                <TextBlock Grid.Column="1" 
                           Text="{Binding OrderTypeArabic}" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Left"
                           Margin="15,0,0,0"/>
            </Grid>
        </Border>

        <!-- 4. Date & Time -->
        <Grid Grid.Row="3" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="الوقت: " FontSize="13" FontWeight="Bold"/>
            <TextBlock Grid.Column="1" Text="{Binding FormattedTime}" FontSize="13"/>
        </Grid>

        <!-- 5. Divider -->
        <Border Grid.Row="4" BorderBrush="Black" BorderThickness="0,1,0,0" Height="2" Margin="0,2,0,5"/>

        <!-- 6. Items List -->
        <ItemsControl Grid.Row="5" ItemsSource="{Binding OrderItems}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="0,6,0,6">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <WrapPanel Grid.Column="0">
                                    <TextBlock Text="{Binding ProductName}" 
                                               FontSize="16" 
                                               FontWeight="Bold" 
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Notes, StringFormat={} ({0})}" 
                                               FontSize="15" 
                                               FontWeight="Bold"
                                               Foreground="Red" 
                                               Margin="8,0,0,0"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasNotes, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </WrapPanel>
                                
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding Quantity, StringFormat={} العدد: {0}}" 
                                           FontSize="18" 
                                           FontWeight="Bold"
                                           Margin="10,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 7. Divider -->
        <Border Grid.Row="6" BorderBrush="Black" BorderThickness="0,2,0,0" Height="3" Margin="0,5,0,5"
                Visibility="{Binding HasOrderNotes, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- 8. Order Notes -->
        <StackPanel Grid.Row="7" Margin="0,5,0,10" Visibility="{Binding HasOrderNotes, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="ملاحظات الطلب العامة:" FontSize="14" FontWeight="Bold" Foreground="Red"/>
            <TextBlock Text="{Binding Notes}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="5,4,0,0"/>
        </StackPanel>
        
        <!-- 9. Bottom Padding (Ensures paper cutting margin) -->
        <Border Grid.Row="8" Height="20"/>
    </Grid>
</UserControl>
