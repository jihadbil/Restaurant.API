<UserControl x:Class="Restaurant.Desktop.Controls.Printing.ReceiptPrintControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignWidth="302"
             Background="White"
             Foreground="Black"
             FontFamily="Arial"
             FontSize="11"
             FlowDirection="RightToLeft">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="10,5,10,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header / Restaurant Info -->
            <RowDefinition Height="Auto"/> <!-- Divider -->
            <RowDefinition Height="Auto"/> <!-- Order Info -->
            <RowDefinition Height="Auto"/> <!-- Divider -->
            <RowDefinition Height="Auto"/> <!-- Items Grid Header -->
            <RowDefinition Height="Auto"/> <!-- Items List -->
            <RowDefinition Height="Auto"/> <!-- Divider -->
            <RowDefinition Height="Auto"/> <!-- Summary (Totals) -->
            <RowDefinition Height="Auto"/> <!-- Divider -->
            <RowDefinition Height="Auto"/> <!-- Notes -->
            <RowDefinition Height="Auto"/> <!-- Footer / Thank You -->
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,5">
            <TextBlock Text="{Binding RestaurantName}" 
                       FontWeight="Bold" 
                       FontSize="16" 
                       HorizontalAlignment="Center" 
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
            <TextBlock Text="فاتورة مبيعات" 
                       FontWeight="SemiBold" 
                       FontSize="12" 
                       HorizontalAlignment="Center" 
                       Margin="0,2,0,0"/>
        </StackPanel>

        <!-- 2. Divider -->
        <Border Grid.Row="1" BorderBrush="Black" BorderThickness="0,1,0,0" Height="2" Margin="0,2,0,5"/>

        <!-- 3. Order Info -->
        <Grid Grid.Row="2" Margin="0,0,0,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Row 0: Order Number & Date -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="رقم الطلب: " FontWeight="Bold"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OrderNumber}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="التاريخ: " FontWeight="Bold"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FormattedDate}"/>

            <!-- Row 1: Order Type & Cashier -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="نوع الطلب: " FontWeight="Bold"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OrderTypeArabic}"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="المستخدم: " FontWeight="Bold"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding UserName}"/>
        </Grid>

        <!-- 4. Divider -->
        <Border Grid.Row="3" BorderBrush="Black" BorderThickness="0,1,0,0" Height="2" Margin="0,2,0,5"/>

        <!-- 5. Items Grid Header -->
        <Grid Grid.Row="4" Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>      <!-- Name -->
                <ColumnDefinition Width="35"/>     <!-- Qty -->
                <ColumnDefinition Width="50"/>     <!-- Price -->
                <ColumnDefinition Width="55"/>     <!-- Total -->
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="المنتج" FontWeight="Bold"/>
            <TextBlock Grid.Column="1" Text="الكمية" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="السعر" FontWeight="Bold" HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="3" Text="الإجمالي" FontWeight="Bold" HorizontalAlignment="Right"/>
        </Grid>

        <!-- 6. Items List -->
        <ItemsControl Grid.Row="5" ItemsSource="{Binding OrderItems}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,2,0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="35"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="55"/>
                            </Grid.ColumnDefinitions>
                            
                            <WrapPanel Grid.Column="0">
                                <TextBlock Text="{Binding ProductName}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Notes, StringFormat={} ({0})}" 
                                           FontStyle="Italic" 
                                           Foreground="#555555" 
                                           Margin="5,0,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasNotes, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </WrapPanel>
                            
                            <TextBlock Grid.Column="1" Text="{Binding Quantity}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding UnitSalePrice, StringFormat={}{0:F2}}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="{Binding Total, StringFormat={}{0:F2}}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 7. Divider -->
        <Border Grid.Row="6" BorderBrush="Black" BorderThickness="0,1,0,0" Height="2" Margin="0,5,0,5"/>

        <!-- 8. Summary (Totals) -->
        <Grid Grid.Row="7" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Subtotal -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="المجموع الفرعي:"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SubTotal, StringFormat={}{0:F2}}" HorizontalAlignment="Right"/>

            <!-- Discount -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="التخفيض:" Visibility="{Binding HasDiscount, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Discount, StringFormat={}{0:F2}}" HorizontalAlignment="Right" Visibility="{Binding HasDiscount, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- Payment Method -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="طريقة الدفع:"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PaymentMethods}" HorizontalAlignment="Right"/>

            <!-- Net Total -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="الصافي:" FontSize="13" FontWeight="Bold" Margin="0,5,0,0"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Total, StringFormat={}{0:F2}}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,5,0,0"/>
        </Grid>

        <!-- 9. Divider -->
        <Border Grid.Row="8" BorderBrush="Black" BorderThickness="0,1,0,0" Height="2" Margin="0,2,0,5" 
                Visibility="{Binding HasOrderNotes, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- 10. Notes -->
        <StackPanel Grid.Row="9" Margin="0,0,0,5" Visibility="{Binding HasOrderNotes, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="ملاحظات:" FontWeight="Bold"/>
            <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Margin="5,2,0,0"/>
        </StackPanel>

        <!-- 11. Footer -->
        <StackPanel Grid.Row="10" HorizontalAlignment="Center" Margin="0,10,0,5">
            <Border BorderBrush="Black" BorderThickness="0,1,0,0" Height="1" Width="150" Margin="0,0,0,5"/>
            <TextBlock Text="شكراً لزيارتكم وصحتين وعافية" 
                       FontWeight="SemiBold" 
                       HorizontalAlignment="Center" 
                       TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
