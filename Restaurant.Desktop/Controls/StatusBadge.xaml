<UserControl x:Class="Restaurant.Desktop.Controls.StatusBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Restaurant.Desktop.Controls"
             xmlns:enums="clr-namespace:Restaurant.Models.Enums;assembly=Restaurant.Models"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="100"
             x:Name="thisBadge">
    <Border x:Name="badgeBorder" CornerRadius="12" Padding="12,4" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="1">
        <TextBlock x:Name="badgeText" Text="غير معروف" Style="{StaticResource TextStyle.Muted}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </Border>

    <UserControl.Triggers>
        <!-- WPF DataTriggers on the DependencyProperty 'Status' -->
    </UserControl.Triggers>
    
    <!-- We'll target the controls inside using Style Triggers in the Resources -->
    <UserControl.Resources>
        <Style TargetType="UserControl">
            <!-- Blank style so we can override via Triggers -->
        </Style>
    </UserControl.Resources>
</UserControl>
